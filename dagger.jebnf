# Dagger Config for OlympusForge (jeBNF)
name = "olympusforge"
engineVersion = "v0.20.0"
sdk { source = "go" }
source = "70000-Environmental-Harness/dagger"
disableDefaultFunctionCaching = true

security {
    untrusted_inputs = ["50RNDF/REPOS/old*", "40RNDL/LAB/lab*"]
    policy = "read-only-mount"
}
