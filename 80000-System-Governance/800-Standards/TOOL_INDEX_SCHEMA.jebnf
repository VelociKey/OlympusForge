# TOOL_INDEX_SCHEMA.jebnf
# Standards for the Authoritative Tool Index

# Individual Tool Entry
Schema ToolEntry {
    ID: String;            # Canonical ID (e.g., "cat", "trivy-fs")
    Executable: Path;      # Path to the physical binary (relative to @BIN)
    Action: String;        # Optional: Subcommand/Action (e.g., "ls", "commit")
    DefaultArgs: String[]; # Optional: Hardcoded baseline parameters
    Version: String;       # Semantic version or git-hash
    Signature: String;     # SHA-256 integrity hash of the binary
    Plane: PlaneID;        # P0, P1, or P2
}

# The Authoritative Index Structure
Index AuthoritativeToolIndex {
    Metadata {
        GeneratedAt: Timestamp;
        HashSync: SHA256;      # Hash of indexing state
        KeyCount: Int;         # Number of keys in the current mPSH
    }

    # mPSH Optimized Lookup Table (Primary)
    LookupTable {
        Seeds: Int[];          # mPSH hashing seeds
        Keys: String[];        # O(1) Keys
        Values: ToolEntry[];   # Verified metadata
    }

    # Active Buffer (Parallel Fallback)
    # Purpose: Stores tools added since the last mPSH regeneration.
    # The Finder utility MUST search this linearly if mPSH misses.
    ActiveBuffer: ToolEntry[];

    # Async Regeneration Trigger
    # When a linear hit occurs in ActiveBuffer, the Finder initiates 
    # a background rebuild of the mPSH to move buffer contents to 
    # the Primary Lookup Table.
    RebuildTrigger: String = "gemaid-finder -rebuild -async";
}
