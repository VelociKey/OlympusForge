load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

proto_library(
    name = "httpv1_proto",
    srcs = ["http.proto"],
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "httpv1_go_proto",
    importpath = "OlympusForge/gen/v1/http",
    proto = ":httpv1_proto",
    visibility = ["//visibility:public"],
)

go_library(
    name = "http",
    embed = [":httpv1_go_proto"],
    importpath = "OlympusForge/gen/v1/http",
    visibility = ["//visibility:public"],
)
