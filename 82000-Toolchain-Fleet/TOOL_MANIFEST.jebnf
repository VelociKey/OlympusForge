::SovereignToolManifest::v1
# Defines Virtual Tools (Subcommands) and Action Overlays

Mappings {
  grep = { Run = "@BIN/gemaid.exe"; Sub = "grep"; };
  ls = { Run = "@BIN/gemaid.exe"; Sub = "ls"; };
  cat = { Run = "@BIN/gemaid.exe"; Sub = "cat"; };
  mkdir = { Run = "@BIN/gemaid.exe"; Sub = "mkdir"; };
  rm = { Run = "@BIN/gemaid.exe"; Sub = "rm"; };
  cp = { Run = "@BIN/gemaid.exe"; Sub = "cp"; };
  mv = { Run = "@BIN/gemaid.exe"; Sub = "mv"; };
  head = { Run = "@BIN/gemaid.exe"; Sub = "head"; };
  tail = { Run = "@BIN/gemaid.exe"; Sub = "tail"; };
  diff = { Run = "@BIN/gemaid.exe"; Sub = "diff"; };
  
  # Git Overlays
  g-commit = { Run = "@BIN/git.exe"; Sub = "commit"; };
  g-push = { Run = "@BIN/git.exe"; Sub = "push"; };
  g-pull = { Run = "@BIN/git.exe"; Sub = "pull"; };
  g-status = { Run = "@BIN/git.exe"; Sub = "status"; };
}
